{
  "name": "jemp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "The single, modular Jobless Empire Discord ecosystem bot.",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "commands:deploy": "tsx src/discord/deploy-commands.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.12.0",
    "ulid": "^3.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
